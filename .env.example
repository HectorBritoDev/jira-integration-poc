# Copy this file to .env and replace the dummy values. Bun loads .env automatically.

# Atlassian account the agent acts as on the Atlassian MCP server.
# The token must be created with scopes; a classic token fails every MCP tool call (see README).
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
ATLASSIAN_SITE=your-site.atlassian.net
JIRA_PROJECT_KEY=ABC

# OAuth 2.0 app on developer.atlassian.com, used by redirect.ts and server.ts
ATLASSIAN_CLIENT_ID=your-oauth-client-id
ATLASSIAN_CLIENT_SECRET=your-oauth-client-secret
# Written by server.ts when the OAuth flow finishes; no need to set it by hand
ATLASSIAN_ACCESS_TOKEN=

# OpenAI-compatible chat endpoint, e.g. a LiteLLM proxy
LITELLM_BASE_URL=http://localhost:4000/
LITELLM_MODEL=your-model-name
# Optional: only needed if the endpoint requires a key
LITELLM_API_KEY=your-litellm-api-key
